{
  "name": "blockfront-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser based online 1v1-5v5 tactical FPS powered by Three.js",
  "scripts": {
    "dev": "NODE_ENV=development node server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "check": "node --check server/index.js && node --check client/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0",
    "vite": "^7.1.0"
  }
}
